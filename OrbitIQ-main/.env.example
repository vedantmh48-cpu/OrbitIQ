# =============================================
# OrbitIQ Download Website — frontend API URL
# =============================================
# Copy this file to `.env` to configure which backend
# the contact form calls. Vite reads VITE_* variables.

# Local development (Express API in /server on port 3000):
VITE_API_URL=http://localhost:3000

# Production (once the API is deployed, e.g. on Render/Railway/Fly):
# VITE_API_URL=https://your-deployed-api.example.com

# Leave VITE_API_URL EMPTY to call /api/contact on the same origin
# (works when the API is served behind the same domain as the site).
#
# The standalone preview (orbit-iq.html) uses the same convention:
# set window.ORBITIQ_API_URL before the </body> script runs, e.g.
#   <script>window.ORBITIQ_API_URL='http://localhost:3000';</script>