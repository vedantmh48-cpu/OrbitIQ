# =============================================
# OrbitIQ Contact API — environment variables
# Copy this file to `server/.env` and fill in
# real values. NEVER commit real credentials.
# =============================================

# HTTP port the API listens on
PORT=3000

# Comma-separated list of browser origins allowed to call the API.
# Leave empty to use the defaults:
#   http://localhost:5173, http://localhost:3000, https://vedantmh48-cpu.github.io
# Example for a deployed setup:
# CORS_ORIGIN=https://vedantmh48-cpu.github.io

# ---------------- MySQL ----------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=orbit_iq

# ---------------- Gmail SMTP ----------------
# Use a Gmail App Password (16 chars, no spaces).
# Create at: https://myaccount.google.com/apppasswords
GMAIL_USER=orbitIQ2606@gmail.com
GMAIL_APP_PASSWORD=

# Where the "New OrbitIQ Contact Message" notification goes.
# Defaults to GMAIL_USER when empty.
ADMIN_EMAIL=orbitIQ2606@gmail.com